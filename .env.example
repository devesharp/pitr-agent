# Copie para .env (local) ou cole no Coolify. Nunca faça commit com valores reais.

# Identificação: vira a pasta pitr/<NAME>/ no bucket
NAME=meu-banco

# Banco
DB_HOST=uuid-ou-hostname-do-banco
DB_USER=pitr
DB_PASSWORD=TROQUE_AQUI
DATABASES=nome_do_banco

# Bucket S3 compatível (Cloudflare R2)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=nome-do-bucket
R2_ACCESS_KEY_ID=TROQUE_AQUI_32_CARACTERES
R2_SECRET_ACCESS_KEY=TROQUE_AQUI_64_CARACTERES

# Alertas no Telegram (opcional)
TG_TOKEN=
TG_CHAT_ID=
TG_THREAD_ID=

# Agendamento
INTERVAL=300
DUMP_HOUR=6

# healthchecks.io (opcional, recomendado)
HC_URL=
